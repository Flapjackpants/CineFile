# Optional API keys for AI-assisted clip selection.
DEEPSEEK_API_KEY=
TYPESAFE_API_KEY=
# Fallback alias used when TYPESAFE_API_KEY is unset.
JEV_API_KEY=

# Optional API base URL overrides (defaults shown).
DEEPSEEK_BASE_URL=https://api.deepseek.com
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional config directory override (settings are stored in cinefile/settings.json).
XDG_CONFIG_HOME=
