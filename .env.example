# Optional API keys for AI-assisted clip selection.
DEEPSEEK_API_KEY=

# Optional API base URL overrides (defaults shown).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional local Laya (MLX) model override (Apple silicon only).
LAYA_MODEL=aac6fef/laya-mlx

# Optional config directory override (settings are stored in cinefile/settings.json).
XDG_CONFIG_HOME=
